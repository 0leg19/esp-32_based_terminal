{
  "name": "nfc-terminal-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Configuration, test and integration tool for the ESP32 NFC terminal",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts --prod",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.63.0",
    "node-forge": "^1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
